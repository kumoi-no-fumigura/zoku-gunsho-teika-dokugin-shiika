  {
   "seq": "12",
   "text": "みそきするあきのたち葉にやとことにかるほともなくませうてつ也",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "秋にたへぬことの葉のみそ色に出る大和の哥ももろかしの詩も",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "目にたてぬかきねにましる梶の葉も道行人の手にならす時",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "一秋風に荻の上葉はそよくなり妻こふ鹿の音こそをそけれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "うらかるゝ秋の白露そめやわく蓬の杣のもとのしけみを",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "おのか色のをよはぬ秋も染かへつ嵐のつてに紅葉ちるたに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "あかつきはかゝらん山の月を見て雲もとまらす秋風の西",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "宮城野の秋の村雨すきやらすそこらの花の枝をたれつゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "月の色に霧にへたてそ難波舟みきはのあしはたつさはるも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "露時雨心やすめないろ〳〵にすさひはこりぬをりのへの秋",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "苦のうへに昨日の紅葉たきすてゝ秋の林に誰あそひけん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "〽たをやめのかふる心に染つくす紅葉もしらしきたる冬とは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "さためなき嵐にかわる山影のくもりはてぬる入あひのかね",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "色〳〵に菊も紅葉もうつろへと春のまゝなる庭のわか松",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "うすくこきよをの紅葉を吹わけてかたるさためぬ風の蝦",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "〽おみ衣白をすへて盃のめく風にかへるよはそたのしき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "かけうつす山の青葉も冬枯そ淋しき池に残るをしかも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ふりまさるよしのゝみゆき跡たてゝせらぬ岩屋は音信もなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "老楽の年のをなかき冬の夢昔も今も身こそことなれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "思ひいつる雪ふるとしとおのれのみ玉きはるよのうきにたへたる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "一国砂の色はひとつに身にしめより月花のをりふしはみつ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "年くれて松きるしつの身の上におひてそ帰る峯の嵐を",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "わかともとみしハ甘くなき年の暮夢かとたにも誰にかたらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬",
   "kotobagaki": ""
  }
 ],
