 "poems": [
  {
   "seq": "1",
   "text": "梅かえのうつす句はうすからし露はよはき春の衣に",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "かきならへて見侍しいたつらことを思ひいてゝかきつく春"
  },
  {
   "seq": "2",
   "text": "いかならんたえて桜の世なりとも明ほのかすむ春のこゝろは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "はるにすむ山の家ゐをきてとへは床よひの月も影まとかなり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "つり舟の里のしるへも事とをしやそ嶋かすむ曙の天",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "雪ものみつもれはつらし木の風別し宅のふるき年〳〵",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "山人のゆくその顔てにためてしはしそやすむ岩のほとりに",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "惜むらんとは逸し花も散すてゝ春はいくかの見ねの客を",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "過かてにをもの春こそわすちれねあらしふりにし道のへの家",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "春ハいぬ青葉の桜おそき日にとするかたみの夕くれの花",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734212",
   "form": "短歌",
   "genre": "",
   "ban": "",
